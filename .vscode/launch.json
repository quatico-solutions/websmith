{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "name": "vscode-jest-tests",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/jest",
            "args": ["--runInBand", "--watchAll=false", "--testNamePattern", "${jest.testNamePattern}", "--runTestsByPath", "${jest.testFile}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "timeout": 600000,
            "restart": true,
            "stopOnEntry": false,
            "runtimeArgs": ["--inspect-brk=9229"],
            "port": 9229,
            "windows": {
                "program": "${workspaceFolder}/node_modules/jest/bin/jest"
            }
        },
        {
            "type": "node",
            "name": "webpack-tests-e2e",
            "request": "launch",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/node_modules/.bin/jest",
            "cwd": "${workspaceFolder}/packages/webpack-test",
            "args": ["-c", "${workspaceFolder}/packages/webpack-test/jest.config.js", "--runInBand", "-o", "--all"],
            "timeout": 600000,
            "restart": true,
            "runtimeArgs": ["--inspect-brk=9230"],
            "port": 9230,
            "windows": {
                "program": "${workspaceFolder}/node_modules/jest/bin/jest"
            }
        },
        {
            "type": "node",
            "name": "Debug Compiler Tests",
            "request": "launch",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/node_modules/.bin/jest",
            "cwd": "${workspaceFolder}/packages/compiler",
            "args": ["--runInBand", "--testTimeout=300000", "src/bin.test.ts"],
            "timeout": 0,
            "restart": false,
            "skipFiles": ["<node_internals>/**"],
            "runtimeArgs": ["--inspect-brk=0"],
            "outputCapture": "console",
            "env": {
                "NODE_ENV": "test"
            },
            "windows": {
                "program": "${workspaceFolder}/node_modules/jest/bin/jest"
            }
        },
        {
            "type": "node",
            "name": "Debug Single Test (No Timeout)",
            "request": "launch",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/node_modules/.bin/jest",
            "cwd": "${workspaceFolder}/packages/compiler",
            "args": ["--runInBand", "--testTimeout=0", "--forceExit=false", "--detectOpenHandles", "${file}"],
            "timeout": 0,
            "restart": false,
            "skipFiles": ["<node_internals>/**"],
            "runtimeArgs": ["--inspect-brk=0"],
            "outputCapture": "console",
            "autoAttachChildProcesses": true,
            "env": {
                "NODE_ENV": "test"
            },
            "windows": {
                "program": "${workspaceFolder}/node_modules/jest/bin/jest"
            }
        }
    ]
}
