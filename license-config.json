{
    "license": "license-header.txt",
    "defaultFormat": {
        "prepend": "/*",
        "append": " */",
        "eachLine": {
            "prepend": " * "
        }
    },
    "licenseFormats": {
        "ts|tsx|js|jsx|scss": {
            "prepend": "/*",
            "append": " */",
            "eachLine": {
                "prepend": " * "
            }
        },
        "md|mdx": {
            "prepend": "<!--",
            "append": "-->",
            "eachLine": {
                "prepend": " "
            }
        },
        "dotfile": {
            "eachLine": {
                "prepend": "# "
            }
        }
    },
    "trailingWhitespace": "TRIM",
    "ignore": [
        "**/*.!(ts|tsx|js|jsx|scss|spec.ts|test.ts|config.js|stories.js|stories.mdx|mdx|md)",
        "**/__snapshots__",
        ".git",
        ".idea",
        ".nx-cache",
        ".husky",
        ".github/ISSUE_TEMPLATE",
        "**/.storybook",
        ".vscode",
        "**/coverage",
        "**/lib",
        "**/bin",
        "**/node_modules",
        "**/docs/catalogue",
        "**/.editorconfig",
        "**/.gitignore",
        "**/.prettierrc",
        "**/*.iml",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "**/*.graffle",
        "**/.gitkeep",
        "**/.build",
        "**/test-data",
        "**/__data__"
    ]
}