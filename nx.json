{
    "extends": "nx/presets/npm.json",
    "cacheDirectory": ".nx-cache",
    "defaultBase": "develop",
    "targetDefaults": {
        "dist": {
            "dependsOn": [
                "^dist"
            ],
            "cache": true
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "{projectRoot}/lib"
            ],
            "cache": true
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ]
        },
        "lint": {
            "dependsOn": [
                "^build"
            ],
            "cache": true
        },
        "test": {
            "cache": true
        },
        "test:e2e": {
            "cache": true
        }
    }
}