{
    "extends": "nx/presets/npm.json",
    "tasksRunnerOptions": {
        "default": {
            "runner": "nx/tasks-runners/default",
            "options": {
                "cacheableOperations": [
                    "dist",
                    "test",
                    "lint",
                    "build",
                    "test:e2e"
                ],
                "cacheDirectory": ".nx-cache"
            }
        }
    },
    "targetDefaults": {
        "dist": {
            "dependsOn": [
                "^dist"
            ]
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "{projectRoot}/lib"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ]
        },
        "lint": {
            "dependsOn": [
                "^build"
            ]
        }
    },
    "affected": {
        "defaultBase": "develop"
    }
}