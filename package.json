{
    "name": "@quatico/websmith",
    "description": "A compiler frontend for the TypeScript compiler",
    "keywords": [
        "typescript",
        "compiler",
        "addons",
        "code generators",
        "code transformers"
    ],
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "private": true,
    "packageManager": "pnpm@10.8.0",
    "scripts": {
        "clean": "rimraf coverage test-output && nx run-many --target=clean",
        "lint": "nx run-many --target=lint",
        "lint:fix": "nx run-many --target=lint:fix",
        "build": "nx run-many --target=build",
        "typecheck": "nx run-many --target=typecheck",
        "watch": "nx run-many --target=watch --parallel=10",
        "watch:test": "nx run-many --target=watch:test --parallel=10",
        "test": "nx run-many --target=test",
        "test:e2e": "nx run-many --target=test:e2e",
        "test:update-snapshots": "nx run-many --target=test:update-snapshots",
        "dist": "nx run-many --target=dist && pnpm test:e2e",
        "license:check": "license-check-and-add check -f license-config.json",
        "license:add": "license-check-and-add add -f license-config.json",
        "license:remove": "license-check-and-add remove -f license-config.json",
        "preinstall": "npx only-allow pnpm"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@nx/eslint-plugin": "^23.3.0",
        "@types/jest": "^30.0.0",
        "@types/node": "24.19.2",
        "@typescript-eslint/eslint-plugin": "8.72.0",
        "@typescript-eslint/parser": "8.72.0",
        "@typescript-eslint/utils": "8.72.0",
        "commander": "^15.0.0",
        "comment-json": "^5.0.0",
        "concurrently": "^10.0.6",
        "cross-env": "10.1.0",
        "deepmerge": "^4.3.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.17.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^78.0.0",
        "globals": "^17.13.0",
        "husky": "9.1.7",
        "jest": "^30.5.2",
        "license-check-and-add": "4.0.5",
        "nx": "^23.3.0",
        "prettier": "^3.9.10",
        "quill-delta": "^5.1.0",
        "rimraf": "6.1.3",
        "rxjs": "^7.8.2",
        "ts-jest": "^29.4.15",
        "tslib": "2.8.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "webpack": "^5.112.0"
    },
    "pnpm": {
        "overrides": {
            "axios@1": "^1.20.0",
            "brace-expansion@5": "^5.0.12",
            "fast-uri@3": "^3.1.9",
            "handlebars@4": "^4.7.10",
            "smol-toml@1": "^1.7.1",
            "undici@7": "^7.29.1"
        },
        "peerDependencyRules": {
            "allowAny": [
                "eslint",
                "@typescript-eslint/parser",
                "eslint-config-prettier"
            ]
        },
        "ignoredBuiltDependencies": [
            "nx"
        ],
        "onlyBuiltDependencies": [
            "@swc/core"
        ]
    }
}