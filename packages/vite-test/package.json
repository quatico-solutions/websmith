    "version": "0.10.0",
    "author": "Quatico Solutions AG",
    "private": true,
    "scripts": {
        "clean": "rimraf coverage test-output*",
        "lint": "eslint \"tests/**/*.{js,ts}\" --color",
        "lint:fix": "eslint \"tests/**/*.{js,ts}\" --color --fix",
