{
    "name": "websmith-loader-test",
    "description": "End-to-end test package for the websmith webpack-loader",
    "version": "0.8.5",
    "author": "Quatico Solutions AG",
    "private": true,
    "scripts": {
        "clean": "rimraf lib coverage test-output",
        "lint": "eslint \"{src,test}/**/*.{js,ts,tsx}\" --color",
        "lint:fix": "eslint \"{src,test}/**/*.{js,ts,tsx}\" --color --fix",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "watch": "tsc --watch",
        "test:e2e": "jest --verbose --runInBand",
        "dist": "pnpm clean && pnpm lint && cross-env-shell NODE_ENV=production \"pnpm build\""
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.6",
        "@eslint/js": "^9.19.0",
        "@nx/eslint-plugin": "^18.3.4",
        "@quatico/websmith-core": "workspace:*",
        "@quatico/websmith-node": "workspace:*",
        "websmith-loader": "workspace:*",
        "@types/jest": "^29.5.14",
        "@types/node": "20.19.9",
        "@types/react": "18",
        "@types/webpack": "^5.28.5",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "@typescript-eslint/utils": "^8.22.0",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^29.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-testing-library": "^7.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "fork-ts-checker-webpack-plugin": "^9.0.2",
        "globals": "^15.14.0",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "rimraf": "^6.0.1",
        "thread-loader": "4.0.4",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.22.0",
        "webpack": "^5.104.1",
        "webpack-cli": "^6.0.1"
    }
}