{
    "name": "@quatico/websmith-webpack-test",
    "description": "Webpack loader for @quatico/websmith-compiler",
    "version": "0.6.0",
    "author": "Quatico Solutions AG",
    "private": true,
    "scripts": {
        "clean": "rimraf lib coverage __data__/**/.build/",
        "lint": "eslint \"{src,test}/**/*.{js,ts,tsx}\" --color",
        "lint:fix": "pnpm lint --fix",
        "build": "tsc",
        "watch": "tsc --watch",
        "test:e2e": "jest --runInBand",
        "dist": "pnpm clean && pnpm lint && cross-env-shell NODE_ENV=production \"pnpm build\""
    },
    "devDependencies": {
        "@eslint/js": "^9.1.1",
        "@nx/eslint-plugin": "^18.3.4",
        "@quatico/websmith-webpack": "workspace:*",
        "@swc/core": "1.5.0",
        "@swc/jest": "0.2.36",
        "@types/jest": "^29.5.12",
        "@types/node": "20",
        "@types/webpack": "^5.28.5",
        "eslint": "^9.1.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-jest": "^28.3.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-testing-library": "^6.2.2",
        "fork-ts-checker-webpack-plugin": "^9.0.2",
        "globals": "^15.1.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "rimraf": "^5.0.5",
        "thread-loader": "4.0.2",
        "typescript": "5.4.5",
        "typescript-eslint": "^7.8.0",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4"
    }
}