{
    "name": "@quatico/websmith-webpack-test",
    "description": "Webpack loader for @quatico/websmith-compiler",
    "version": "0.4.2",
    "author": "Quatico Solutions AG",
    "private": true,
    "scripts": {
        "clean": "rimraf lib coverage __data__/**/.build/",
        "lint": "eslint \"{src,test}/**/*.{js,ts,tsx}\" --fix --color",
        "build": "tsc",
        "watch": "tsc --watch",
        "test:e2e": "jest --runInBand",
        "dist": "pnpm clean && pnpm lint && cross-env-shell NODE_ENV=production \"pnpm build\" && pnpm test:e2e"
    },
    "devDependencies": {
        "@quatico/websmith-api": "workspace:^",
        "@quatico/websmith-core": "workspace:^",
        "@quatico/websmith-webpack": "workspace:^",
        "@swc/core": "1.4.14",
        "@swc/jest": "0.2.36",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.12.7",
        "@types/webpack": "^5.28.5",
        "@typescript-eslint/eslint-plugin": "^7.7.0",
        "@typescript-eslint/parser": "^7.7.0",
        "eslint": "^8.12.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jest": "^28.2.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-testing-library": "^6.2.2",
        "fork-ts-checker-webpack-plugin": "^9.0.2",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "rimraf": "^5.0.5",
        "thread-loader": "4.0.2",
        "typescript": "5.4.5",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4"
    }
}