{
    "name": "@quatico/websmith-webpack-test",
    "description": "Webpack loader for @quatico/websmith-compiler",
    "version": "0.4.2",
    "author": "Quatico Solutions AG",
    "private": true,
    "scripts": {
        "clean": "rimraf lib coverage __data__/**/.build/",
        "lint": "eslint \"{src,test}/**/*.{js,ts,tsx}\" --fix --color",
        "build": "tsc",
        "watch": "tsc --watch",
        "test:e2e": "jest --runInBand",
        "dist": "yarn clean && yarn lint && cross-env-shell NODE_ENV=production \"yarn build\" && yarn test:e2e"
    },
    "devDependencies": {
        "@quatico/websmith-api": "^0.4.2",
        "@quatico/websmith-core": "^0.4.2",
        "@quatico/websmith-webpack": "^0.4.2",
        "@swc/core": "1.3.76",
        "@swc/jest": "0.2.28",
        "@types/jest": "^29.2.2",
        "@types/node": "20",
        "@types/react": " 18.2.20",
        "@types/react-dom": "18.2.7",
        "@types/webpack": "^5.28.0",
        "@typescript-eslint/eslint-plugin": "^6.3.0",
        "@typescript-eslint/parser": "^6.3.0",
        "eslint": "^8.14.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-import": "^2.22.1",
        "eslint-plugin-jest": "^27.1.4",
        "eslint-plugin-prettier": "^5.0.0",
        "eslint-plugin-testing-library": "^5.3.1",
        "fork-ts-checker-webpack-plugin": "^8.0.0",
        "jest": "^29.3.1",
        "prettier": "^3.0.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "rimraf": "^5.0.0",
        "thread-loader": "4.0.2",
        "ts-jest": "^29.0.3",
        "typescript": "5.1.6",
        "webpack": "^5.75.0",
        "webpack-cli": "^5.0.2"
    }
}