{
    "name": "websmith-loader-test",
    "description": "End-to-end test package for the websmith webpack-loader",
    "version": "0.10.0",
    "author": "Quatico Solutions AG",
    "private": true,
    "scripts": {
        "clean": "rimraf lib coverage test-output",
        "lint": "eslint \"{src,tests,perf}/**/*.{js,cjs,ts,tsx}\" --color",
        "lint:fix": "eslint \"{src,tests,perf}/**/*.{js,cjs,ts,tsx}\" --color --fix",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "watch": "tsc --watch",
        "test:e2e": "jest --verbose --runInBand",
        "perf:esm": "node perf/esm-watch-bench.cjs",
        "dist": "pnpm clean && pnpm lint && cross-env-shell NODE_ENV=production \"pnpm build\""
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@nx/eslint-plugin": "^23.2.1",
        "@quatico/websmith-core": "workspace:*",
        "@quatico/websmith-node": "workspace:*",
        "websmith-loader": "workspace:*",
        "@types/jest": "^30.0.0",
        "@types/node": "26.6.2",
        "@types/react": "19",
        "@types/webpack": "^5.28.5",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@typescript-eslint/utils": "^8.70.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^76.0.0",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.9",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "rimraf": "^6.1.3",
        "thread-loader": "4.0.4",
        "ts-jest": "^29.4.14",
        "ts-loader": "^9.6.2",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.70.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    }
}