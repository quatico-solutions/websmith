{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "types": ["node"],
        "lib": ["ES2020"],
        "module": "CommonJS",
        "moduleResolution": null,
        "target": "ES2020",
        "outDir": "./lib",
        "rootDir": "./src",
        "noEmit": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "src/**/*.spec.ts", "tests/**/*.test.ts"]
}
