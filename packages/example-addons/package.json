{
    "name": "@quatico/websmith-examples",
    "version": "0.10.0",
    "description": "A library of example addons for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "engines": {
        "node": ">=22.12"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "README.md",
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib dist bin coverage test-output",
        "lint": "eslint \"{addons,tests}/**/*.ts\" --color",
        "lint:fix": "eslint \"{addons,tests}/**/*.ts\" --color --fix",
        "execute": "websmith --addons foo-added-generator,foobar-export-processor,foobar-replace-transformer,function-json-result-processor -p tsconfig.execute.json",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "watch": "pnpm build --watch",
        "watch:test": "jest --watch --runInBand",
        "test:e2e": "jest --coverage --runInBand --passWithNoTests",
        "test:update-snapshots": "pnpm test -u",
        "dist": "pnpm clean && pnpm lint && cross-env-shell NODE_ENV=production \"pnpm build\""
    },
    "peerDependencies": {
        "@quatico/websmith-api": "workspace:*",
        "typescript": "5.x"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@nx/eslint-plugin": "^23.2.1",
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-testing": "workspace:*",
        "@types/jest": "^30.0.0",
        "@types/node": "26.6.2",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@typescript-eslint/utils": "^8.70.1",
        "concurrently": "^10.0.5",
        "cross-env": "10.1.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^76.0.0",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.9",
        "rimraf": "6.1.3",
        "ts-jest": "^29.4.14",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.70.1"
    }
}