{
    "name": "@quatico/websmith-webpack",
    "description": "Webpack loader for @quatico/websmith-compiler",
    "version": "0.6.3",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "main": "src/index.ts",
    "publishConfig": {
        "main": "lib/index.js",
        "types": "lib/index.d.ts"
    },
    "files": [
        "LICENSE",
        "README.md",
        "lib"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "scripts": {
        "clean": "rimraf lib coverage",
        "lint": "eslint \"{src,tests}/**/*.{js,ts,tsx}\" --color",
        "lint:fix": "pnpm lint --fix",
        "build": "tsc",
        "watch": "tsc --watch",
        "watch:test": "jest --watch",
        "test": "jest --coverage",
        "dist": "pnpm clean && pnpm lint && pnpm test && cross-env-shell NODE_ENV=production \"pnpm build\""
    },
    "dependencies": {
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-core": "workspace:*"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.5",
        "@eslint/js": "^9.17.0",
        "@nx/eslint-plugin": "^18.3.4",
        "@quatico/websmith-testing": "workspace:*",
        "@types/jest": "^29.5.12",
        "@types/node": "20",
        "@types/webpack": "^5.28.5",
        "@typescript-eslint/eslint-plugin": "^8.18.0",
        "@typescript-eslint/parser": "^8.18.0",
        "@typescript-eslint/utils": "^8.19.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.9.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-testing-library": "^7.1.1",
        "fork-ts-checker-webpack-plugin": "^9.0.2",
        "globals": "^15.1.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "rimraf": "^5.0.5",
        "thread-loader": "4.0.2",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "typescript": "5.4.5",
        "typescript-eslint": "^8.18.0",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4"
    },
    "peerDependencies": {
        "webpack": "5.x"
    }
}