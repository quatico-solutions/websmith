{
    "name": "websmith-loader",
    "version": "0.10.0",
    "description": "A webpack loader for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "engines": {
        "node": ">=22.12"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "README.md",
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib coverage test-output test-temp",
        "lint": "eslint \"{src,tests}/**/*.{js,ts,tsx}\" --color",
        "lint:fix": "eslint \"{src,tests}/**/*.{js,ts,tsx}\" --color --fix",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "watch": "tsc --watch",
        "watch:test": "jest --testRegex=\".*\\.spec\\.ts$\" --watch",
        "test": "jest --testRegex=\".*\\.spec\\.ts$\" --coverage",
        "test:e2e": "jest --testRegex=\".*\\.test\\.ts$\"",
        "dist": "pnpm clean && pnpm lint && pnpm test && cross-env-shell NODE_ENV=production \"pnpm build\""
    },
    "dependencies": {
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-core": "workspace:*",
        "comment-json": "^4.2.5"
    },
    "peerDependencies": {
        "webpack": "5.x"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@nx/eslint-plugin": "^23.2.1",
        "@types/jest": "^30.0.0",
        "@types/node": "26.6.2",
        "@types/webpack": "^5.28.5",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@typescript-eslint/utils": "^8.70.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^76.0.0",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.9",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.14",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.70.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    }
}