{
    "name": "websmith-loader",
    "version": "0.7.12",
    "description": "A webpack loader for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "README.md",
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib coverage test-output",
        "lint": "eslint \"{src,tests}/**/*.{js,ts,tsx}\" --color",
        "lint:fix": "pnpm lint --fix",
        "build": "tsc",
        "watch": "tsc --watch",
        "watch:test": "jest --testRegex=\".*\\.spec\\.ts$\" --watch",
        "test": "jest --testRegex=\".*\\.spec\\.ts$\" --coverage",
        "test:e2e": "jest --testRegex=\".*\\.test\\.ts$\"",
        "dist": "pnpm clean && pnpm lint && pnpm test && cross-env-shell NODE_ENV=production \"pnpm build\""
    },
    "dependencies": {
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-core": "workspace:*",
        "comment-json": "^4.2.5"
    },
    "peerDependencies": {
        "webpack": "5.x"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.6",
        "@eslint/js": "^9.19.0",
        "@nx/eslint-plugin": "^18.3.4",
        "@types/jest": "^29.5.14",
        "@types/node": "20.19.9",
        "@types/webpack": "^5.28.5",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "@typescript-eslint/utils": "^8.22.0",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^29.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-testing-library": "^7.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "globals": "^15.14.0",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.2.5",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.22.0",
        "webpack": "^5.97.1",
        "webpack-cli": "^6.0.1"
    }
}