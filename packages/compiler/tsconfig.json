{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2020",
        "lib": ["ES2020"],
        "outDir": "./lib",
        "noEmit": false,
        "baseUrl": ".",
        "paths": {
            "@quatico/websmith-api": ["../api/src"],
            "@quatico/websmith-core": ["../core/src"]
        }
    },
    "exclude": ["node_modules", "src/**/*.spec.ts", "src/**/*.test.ts"],
    "include": ["src/**/*.ts"]
}
