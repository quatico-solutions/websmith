{
    "name": "@quatico/websmith-compiler",
    "version": "0.10.0",
    "description": "A CLI for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "engines": {
        "node": ">=22.12"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "bin": {
        "websmith": "bin/bin.js"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "README.md",
        "bin",
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib bin coverage test-output",
        "lint": "eslint \"{src,test}/**/*.ts\" --color",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --color --fix",
        "build": "pnpm build:lib && pnpm build:binary",
        "build:binary": "webpack",
        "build:lib": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "watch": "tsc --watch",
        "watch:test": "jest --testRegex=\".*\\.spec\\.ts$\" --watch",
        "test": "jest --testRegex=\".*\\.spec\\.ts$\" --coverage",
        "test:e2e": "jest --testRegex=\".*\\.test\\.ts$\"",
        "test:update-snapshots": "pnpm test -u",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\""
    },
    "dependencies": {
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-core": "workspace:*",
        "commander": "^13.1.0",
        "minimist": "^1.2.8",
        "tslib": "2.8.1",
        "typescript": "5.7.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@nx/eslint-plugin": "^23.2.1",
        "@quatico/websmith-examples": "workspace:*",
        "@types/jest": "^30.0.0",
        "@types/minimist": "^1.2.5",
        "@types/node": "26.6.2",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@typescript-eslint/utils": "^8.70.1",
        "concurrently": "^10.0.5",
        "cross-env": "10.1.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^76.0.0",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.9",
        "rimraf": "6.1.3",
        "ts-jest": "^29.4.14",
        "ts-loader": "^9.6.2",
        "typescript-eslint": "^8.70.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    }
}