{
    "name": "@quatico/websmith-compiler",
    "version": "0.6.3",
    "description": "A CLI for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "main": "src/index.ts",
    "publishConfig": {
        "main": "bin/index.js",
        "types": "bin/index.d.ts"
    },
    "bin": {
        "websmith": "bin/bin.js"
    },
    "files": [
        "LICENSE",
        "README.md",
        "bin"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "scripts": {
        "clean": "rimraf lib bin coverage",
        "lint": "eslint \"{src,test}/**/*.ts\" --color",
        "lint:fix": "pnpm lint --fix",
        "build": "tsc",
        "watch": "tsc --watch",
        "watch:test": "jest --watch",
        "test": "jest --coverage",
        "test:update-snapshots": "pnpm test -u",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\""
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.5",
        "@eslint/js": "^9.17.0",
        "@nx/eslint-plugin": "^18.3.4",
        "@quatico/websmith-testing": "workspace:*",
        "@swc/core": "1.5.0",
        "@swc/jest": "0.2.36",
        "@types/jest": "^29.5.12",
        "@types/minimist": "^1.2.5",
        "@types/node": "20",
        "@typescript-eslint/eslint-plugin": "^8.18.0",
        "@typescript-eslint/parser": "^8.18.0",
        "@typescript-eslint/utils": "^8.19.0",
        "concurrently": "^8.2.2",
        "cross-env": "7.0.3",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.9.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-testing-library": "^7.1.1",
        "globals": "^15.1.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "rimraf": "5.0.5",
        "typescript-eslint": "^8.18.0"
    },
    "dependencies": {
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-core": "workspace:*",
        "commander": "^12.0.0",
        "minimist": "^1.2.8",
        "ts-node": "^10.9.2",
        "tslib": "2.6.2",
        "typescript": "5.4.5"
    }
}