{
    "name": "@quatico/websmith-vite",
    "version": "0.10.0",
    "description": "A Vite plugin for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "engines": {
        "node": ">=22.12"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.mts",
                "default": "./lib/index.mjs"
            },
            "require": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "README.md",
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib coverage test-output test-temp",
        "lint": "eslint \"{src,tests}/**/*.{js,ts,tsx,mts}\" --color",
        "lint:fix": "eslint \"{src,tests}/**/*.{js,ts,tsx,mts}\" --color --fix",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "watch": "tsc --watch",
        "watch:test": "jest --testRegex=\".*\\.spec\\.ts$\" --watch",
        "test": "jest --testRegex=\".*\\.spec\\.ts$\" --coverage",
        "dist": "pnpm clean && pnpm lint && pnpm test && cross-env-shell NODE_ENV=production \"pnpm build\""
    },
    "dependencies": {
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-core": "workspace:*",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "typescript": ">=5.7 <7",
        "vite": "^6.3.0 || ^7.0.0"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@nx/eslint-plugin": "^23.3.0",
        "@types/jest": "^30.0.0",
        "@types/node": "26.6.4",
        "@typescript-eslint/eslint-plugin": "8.71.1",
        "@typescript-eslint/parser": "8.71.1",
        "@typescript-eslint/utils": "8.71.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^77.0.0",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.9",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.7",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.1",
        "vite": "^8.3.4"
    }
}
