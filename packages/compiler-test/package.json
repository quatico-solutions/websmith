{
    "name": "@quatico/websmith-compiler-test",
    "version": "0.10.0",
    "description": "End-to-end test package for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "private": true,
    "scripts": {
        "clean": "rimraf lib bin coverage test-output",
        "lint": "eslint \"{src,test}/**/*.ts\" --color",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --color --fix",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "watch": "tsc --watch",
        "dist": "pnpm clean && pnpm lint && cross-env-shell NODE_ENV=production \"pnpm build\"",
        "test:e2e": "jest --verbose --runInBand"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@nx/eslint-plugin": "^23.3.0",
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-core": "workspace:*",
        "@quatico/websmith-node": "workspace:*",
        "@quatico/websmith-testing": "workspace:*",
        "@types/jest": "^30.0.0",
        "@types/node": "24.13.6",
        "@typescript-eslint/eslint-plugin": "8.71.2",
        "@typescript-eslint/parser": "8.71.2",
        "@typescript-eslint/utils": "8.71.2",
        "concurrently": "^10.0.6",
        "cross-env": "10.1.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.17.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^78.0.0",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.10",
        "rimraf": "6.1.3",
        "ts-jest": "^29.4.7",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2"
    }
}