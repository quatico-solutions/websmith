{
    "name": "@quatico/websmith-core",
    "version": "0.11.0",
    "description": "Shared library functions for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "engines": {
        "node": ">=22.12"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "LICENSE",
        "README.md",
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib bin coverage test-output",
        "lint": "eslint \"{src,test}/**/*.ts\" --color",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --color --fix",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "watch": "tsc --watch",
        "watch:test": "jest --testRegex \"(.*\\.spec\\.ts)\" --watch",
        "test": "jest --testRegex \"(.*\\.spec\\.ts)\" --coverage",
        "test:e2e": "jest --testRegex \"(.*\\.test\\.ts)\"",
        "test:update-snapshots": "pnpm test -u",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\""
    },
    "dependencies": {
        "@quatico/websmith-api": "workspace:*",
        "cjs-module-lexer": "^2.3.0",
        "comment-json": "^5.0.0",
        "deepmerge": "^4.3.1",
        "lodash": "^4.18.1",
        "resolve.exports": "^2.0.4",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "typescript": ">=5.7 <7"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@nx/eslint-plugin": "^23.3.0",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.26",
        "@types/node": "24.19.2",
        "@typescript-eslint/eslint-plugin": "8.72.0",
        "@typescript-eslint/parser": "8.72.0",
        "@typescript-eslint/utils": "8.72.0",
        "concurrently": "^10.0.6",
        "cross-env": "10.1.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.17.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^78.0.0",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.10",
        "rimraf": "6.1.3",
        "ts-jest": "^29.4.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0"
    }
}