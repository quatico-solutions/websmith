{
    "name": "@quatico/websmith-core",
    "version": "0.7.4",
    "description": "Shared library functions for the websmith compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "main": "src/index.ts",
    "publishConfig": {
        "main": "lib/index.js",
        "types": "lib/index.d.ts"
    },
    "files": [
        "LICENSE",
        "README.md",
        "lib"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "scripts": {
        "clean": "rimraf lib bin coverage",
        "lint": "eslint \"{src,test}/**/*.ts\" --color",
        "lint:fix": "pnpm lint --fix",
        "build": "tsc",
        "watch": "tsc --watch",
        "watch:test": "jest --watch",
        "test": "jest --coverage",
        "test:update-snapshots": "pnpm test -u",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\""
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.6",
        "@eslint/js": "^9.19.0",
        "@nx/eslint-plugin": "^18.3.4",
        "@types/jest": "^29.5.14",
        "@types/lodash": "^4.17.15",
        "@types/node": "20.19.9",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "@typescript-eslint/utils": "^8.22.0",
        "concurrently": "^9.1.2",
        "cross-env": "7.0.3",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.11.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-testing-library": "^7.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "globals": "^15.14.0",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "rimraf": "6.0.1",
        "ts-jest": "^29.2.5",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.22.0"
    },
    "dependencies": {
        "@quatico/websmith-api": "workspace:*",
        "comment-json": "^4.2.5",
        "create-hash": "1.2.0",
        "deepmerge": "^4.3.1",
        "lodash": "^4.17.21",
        "path": "0.12.7"
    },
    "peerDependencies": {
        "typescript": "5.x"
    }
}