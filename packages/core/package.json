{
    "name": "@quatico/websmith-core",
    "version": "0.5.1",
    "description": "A frontend for the TypeScript compiler",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "files": [
        "LICENSE",
        "README.md",
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib bin coverage",
        "lint": "eslint \"{src,test}/**/*.ts\" --color",
        "lint:fix": "pnpm lint --fix",
        "build": "tsc",
        "watch": "tsc --watch",
        "watch:test": "jest --watch",
        "test": "jest --coverage",
        "test:update-snapshots": "pnpm test -u",
        "dist": "cross-env-shell NODE_ENV=production \"pnpm clean && pnpm lint && pnpm test && pnpm build\"",
        "publish-npm": "npm publish --access public"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@nx/eslint-plugin": "^18.2.4",
        "@swc/core": "1.4.14",
        "@swc/jest": "0.2.36",
        "@types/jest": "^29.5.12",
        "@types/lodash": "^4.17.0",
        "@types/node": "^20.12.7",
        "concurrently": "^8.2.2",
        "cross-env": "7.0.3",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jest": "^28.2.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-testing-library": "^6.2.2",
        "eslint": "^9.0.0",
        "globals": "^15.0.0",
        "jest": "^29.7.0",
        "memfs": "^4.8.2",
        "prettier": "^3.2.5",
        "rimraf": "5.0.5",
        "typescript-eslint": "^7.7.0",
        "typescript": "5.4.5"
    },
    "dependencies": {
        "@quatico/websmith-api": "workspace:^",
        "create-hash": "1.2.0",
        "lodash": "^4.17.21",
        "path": "0.12.7"
    },
    "peerDependencies": {
        "typescript": "5.x"
    }
}