{
    "name": "@quatico/websmith-node",
    "version": "0.8.0",
    "description": "Node library for running websmith with CLI and webpack in Node.js",
    "author": "Quatico Solutions AG",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quatico-solutions/websmith.git"
    },
    "bugs": {
        "url": "https://github.com/quatico-solutions/websmith/issues"
    },
    "homepage": "https://github.com/quatico-solutions/websmith#readme",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "README.md",
        "lib"
    ],
    "scripts": {
        "clean": "rimraf lib bin coverage test-output",
        "lint": "eslint \"{src,test}/**/*.ts\" --color && pnpm typecheck",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --color --fix",
        "build": "tsc",
        "typecheck": "tsc --project tsconfig.test.json",
        "watch": "tsc --watch",
        "watch:test": "jest --watch",
        "test": "jest",
        "test:update-snapshots": "pnpm test -u",
        "dist": "pnpm clean && pnpm lint && pnpm test && cross-env-shell NODE_ENV=production \"pnpm build\""
    },
    "dependencies": {
        "cross-spawn": "^7.0.6",
        "lodash": "^4.17.21",
        "path-exists": "^5.0.0",
        "tildify": "^3.0.0"
    },
    "peerDependencies": {
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-core": "workspace:*",
        "ts-loader": "9.x",
        "typescript": "5.x",
        "webpack": "5.x"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.6",
        "@eslint/js": "^9.19.0",
        "@nx/eslint-plugin": "^18.3.4",
        "@quatico/websmith-api": "workspace:*",
        "@quatico/websmith-core": "workspace:*",
        "websmith-loader": "workspace:*",
        "@types/cross-spawn": "^6.0.6",
        "@types/jest": "^29.5.14",
        "@types/lodash": "^4.17.15",
        "@types/node": "20.19.9",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "@typescript-eslint/utils": "^8.22.0",
        "concurrently": "^9.1.2",
        "cross-env": "7.0.3",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^29.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-testing-library": "^7.1.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "globals": "^15.14.0",
        "jest": "^29.7.0",
        "memfs": "^4.17.0",
        "prettier": "^3.4.2",
        "rimraf": "6.0.1",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.22.0",
        "webpack": "^5.97.1"
    }
}